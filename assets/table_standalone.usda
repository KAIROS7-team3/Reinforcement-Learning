#usda 1.0
(
    defaultPrim = "table"
    metersPerUnit = 1
    upAxis = "Z"
)

def "table" (
    delete apiSchemas = ["PhysxMeshMergeCollisionAPI", "PhysicsMeshCollisionAPI", "PhysicsCollisionAPI"]
    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxMeshMergeCollisionAPI"]
