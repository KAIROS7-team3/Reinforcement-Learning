            float physxLimit:angular:stiffness = 100000
            custom float physxMimicJoint:rotX:dampingRatio = 0
            float physxMimicJoint:rotX:gearing = -1
            custom float physxMimicJoint:rotX:naturalFrequency = 0
            custom rel physxMimicJoint:rotX:referenceJoint = </e0509/joints/rh_r1>
