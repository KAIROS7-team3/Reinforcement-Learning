    over "rh_p12_rn_r1"
    {
        string isaac:nameOverride (
            displayName = "Name Override"
            doc = "Name override for prim lookup in base name search"
        )
        vector3f physics:angularVelocity = (0, 0, 0)
        rel physics:simulationOwner
        vector3f physics:velocity = (0, 0, 0)
        quatd xformOp:orient = (-0.009964413149090032, 0.9999503539968654, -0.000002060251754819724, 0.0000028095396504927)
        double3 xformOp:translate = (0.3730005621910095, -0.008000977337360382, 0.3569979667663574)

        over "visuals" (
