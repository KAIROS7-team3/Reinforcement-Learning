        quatd xformOp:orient = (0.9999999999999993, -3.3254050789822156e-8, -1.4102986365033576e-8, -5.248000686527472e-9)
        double3 xformOp:translate = (6.002665031701326e-11, -1.1175870895385742e-8, 0.20449990034103394)
