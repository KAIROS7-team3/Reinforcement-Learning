        quatd xformOp:orient = (0.009971637898998579, 0.9999502819767956, -0.000002115850630290896, 0.00000276791016205724)
        double3 xformOp:translate = (0.3730006217956543, 0.00799902155995369, 0.35699784755706787)

        over "visuals" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysxTriangleMeshCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
