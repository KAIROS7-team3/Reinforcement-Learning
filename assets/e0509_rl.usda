#usda 1.0
(
    defaultPrim = "e0509"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "e0509" (
    variants = {
        string Physics = "PhysX"
        string Robot = "Robot"
        string Sensor = "Sensors"
    }
    prepend variantSets = ["Physics", "Sensor", "Robot"]
)
{
    string isaac:namespace (
        displayName = "Namespace"
        doc = "Namespace of the prim in Isaac Sim"
    )

    over "joints"
    {
        over "rh_r1"
        {
            float drive:angular:physics:damping = 8
            float drive:angular:physics:maxForce = 1000
            float drive:angular:physics:stiffness = 30
            float drive:angular:physics:targetPosition = 0
            string isaac:nameOverride (
                displayName = "Name Override"
                doc = "Name override for prim lookup in base name search"
            )
            float physics:lowerLimit = 0
            float physics:upperLimit = 63
            float physxJoint:jointFriction = 0
            float physxJoint:maxJointVelocity = 120
            float state:angular:physics:position = 1.142297
            float state:angular:physics:velocity = 0
        }

        over "rh_r2"
